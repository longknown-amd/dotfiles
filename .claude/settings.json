{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "TodoRead"
    ]
  },
  "model": "claude-sonnet-5[1m]",
  "disabledMcpjsonServers": [
    "cloud-atlassian",
    "onenote"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Start your response with **Native phrasing:** followed by a natural, native-English rephrasing of the user prompt on a single line, then answer normally. Skip this for trivial acknowledgments (ok, thanks, yes please) or messages already in clean direct command form.\"}}'"
          },
          {
            "type": "command",
            "command": "python3 -c \"exec(open(__import__('os').path.join(__import__('os').path.expanduser('~'),'.claude','hooks','dotfiles-dirty-check.py')).read())\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "theme": "auto",
  "editorMode": "vim",
  "vim": true
}
